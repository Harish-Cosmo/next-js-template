# Copy to .env.local and fill in. Never commit .env.local.
#
# config/project.json is the committed source of truth for site identity,
# SEO and brand. These environment variables only override it per deployment.

# Absolute production URL. Used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# "false" blocks indexing. Useful for staging and preview deployments.
NEXT_PUBLIC_SITE_INDEXABLE=true

# Optional analytics id. The provider is chosen in config/project.json.
NEXT_PUBLIC_ANALYTICS_ID=

# Add secrets below. Never prefix a secret with NEXT_PUBLIC_.
# DATABASE_URL=
# AUTH_SECRET=
